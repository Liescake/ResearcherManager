# =============================================================================
# Docker / Compose 环境变量示例（公开模板，**不含任何真实密钥**）
#
# 用法（本地开发档）：
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d postgres
#
# 用法（生产档）：
#   cp .env.docker.example .env.docker.prod
#   # 逐项把 change-me-* / REPLACE-ME-* 换成真实值（口令用密钥管理系统生成并注入）
#   docker compose -f docker-compose.prod.yml --env-file .env.docker.prod config
#
# 约定：
#   1. 本文件里的值全部是**占位符**，不是可用的口令/密钥；`pnpm verify:docker`
#      会校验机密类字段仍然只有占位符形态，防止有人把真实密钥写进公开模板。
#   2. 真实 .env.docker / .env.docker.prod 已被 .gitignore 排除，禁止提交。
#   3. 口令生成：openssl rand -base64 48（至少 32 字节随机值）。
#   4. 证书只登记**宿主机目录**（RM_TLS_DIR）；证书内容绝不写入仓库
#      （.gitignore / .dockerignore 已排除 certs/、*.pem、*.key）。
# =============================================================================

# ---------- 运行档位 ----------
LOG_LEVEL=info

# ---------- 数据库凭据（无内置默认值：未提供时 Compose 直接报错退出） ----------
POSTGRES_USER=rm
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=researcher_manager
# 宿主机发布端口，默认 55432（避开宿主机已装的 5432）；生产档不发布端口
POSTGRES_PORT=55432

# ---------- API ----------
API_PORT=3000
API_PREFIX=/api/v1
# 生产档必填：API 对外地址（日志与导出下载链接使用）
API_PUBLIC_URL=http://127.0.0.1:3000
# 会话密钥：至少 32 字节随机值；生产档必填且必须替换占位符
SESSION_SECRET=change-me-session-secret

# ---------- 数据库连接串（**生产档必填**） ----------
# 本地开发档的 api 服务按设计**不注入** DATABASE_URL（会话存储切片落地前带库启动会
# fail-closed，见 README「边界」）。生产档必须提供，并与上面的 POSTGRES_* 保持一致。
# 主机名用编排网络内的服务名 postgres；sslmode=verify-full 与编排里写死的档位一致。
DATABASE_URL=postgresql://rm:change-me-db-password@postgres:5432/researcher_manager?sslmode=verify-full
DATABASE_APPLICATION_NAME=researcher-manager-api

# ---------- TLS 证书挂载（**生产档必填**） ----------
# 宿主机上的证书目录（绝对路径）。WSL2 里形如 /home/<user>/rm-certs；
# Windows 盘符形如 C:/rm-certs。目录内需要（生产档）：
#   ca.pem  server.crt  server.key  pg_hba.conf
# 权限：证书与 pg_hba.conf 需对容器内 postgres 用户可读（644）；
# server.key 建议 640 且属主可读，详见 DOCKER.md「证书准备」。
RM_TLS_DIR=/home/your-user/rm-certs
# 双向 TLS（可选，默认不使用）：同时提供客户端证书与私钥的**容器内路径**才生效
RM_TLS_CLIENT_CERT_PATH=
RM_TLS_CLIENT_KEY_PATH=

# ---------- SQL 执行器取证事实（**生产档必填**，必须是真实验证结果） ----------
# 这些值必须由真的做过验证的人或 CI 填写：代码不会生成「已验证」，
# 缺失时应用在任何数据库连接之前终止启动（fail-closed）。
# CI 运行链接 / 集成测试用例路径都属于可核对的 evidenceRef。
DATABASE_EXECUTOR_EVIDENCE_ID=REPLACE-ME-evidence-id
DATABASE_EXECUTOR_VERIFIED_BY=REPLACE-ME-verified-by
DATABASE_EXECUTOR_VERIFIED_AT=REPLACE-ME-verified-at
DATABASE_EXECUTOR_EVIDENCE_REF=REPLACE-ME-evidence-ref
DATABASE_EXECUTOR_EVIDENCE_METHOD=REPLACE-ME-evidence-method
DATABASE_SCHEMA_READINESS_ID=REPLACE-ME-schema-readiness-id
DATABASE_SCHEMA_CHECKED_BY=REPLACE-ME-checked-by
DATABASE_SCHEMA_CHECKED_AT=REPLACE-ME-checked-at
DATABASE_SCHEMA_READINESS_REF=REPLACE-ME-readiness-ref
# 迁移版本事实：必须按 `pnpm db:migrate:status` 的真实输出核对后填写
DATABASE_MIGRATION_AVAILABLE_VERSIONS=0001
DATABASE_MIGRATION_APPLIED_VERSIONS=0001

# ---------- AI 适配层 ----------
# mock = 本地不联网桩；http-json = 兼容 OpenAI Chat Completions 的服务；
# disabled = 明确关闭。这里**留空**，让两档各自落到自己的安全默认值：
#   开发档 -> mock（本地桩），生产档 -> disabled（生产默认不联网）。
# 需要真实 AI 时显式改成 http-json 并配置下面三项（AI_BASE_URL 必填）。
AI_PROVIDER=
AI_MATCHING_ENABLED=false
AI_BASE_URL=
AI_API_KEY=change-me-ai-api-key
AI_MODEL=
