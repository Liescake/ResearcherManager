# 依赖安装策略（经 P3 评估的最小集合，不引入额外私有源）
registry=https://registry.npmjs.org/

# store / cache 落在仓库内，便于沙箱与 CI 复现，也避免污染用户级目录
store-dir=.pnpm-store
cache-dir=.pnpm-cache

# 使用扁平（hoisted）node_modules 布局。
# 原因：isolated 布局依赖目录链接（Windows junction / 符号链接）定位传递依赖，
# 在链接无法被 Node 规范化解析的环境（受限沙箱、部分容器与网络盘）会导致
# ERR_MODULE_NOT_FOUND（实测：eslint 找不到 @humanfs/node，vitest 找不到 std-env）。
# 取舍：牺牲 pnpm 的严格依赖隔离（可能出现幽灵依赖），换取受限环境下可复现的安装与运行。
node-linker=hoisted

# 用复制而不是硬链接把包放进 node_modules。
# 原因：硬链接会继承存储区文件的访问控制项；当存储区文件不带当前工作区的写/删除授权时，
# 后续安装或清理无法删除这些文件（表现为 Access is denied，甚至安装进程反复重试卡住）。
# 代价：安装更慢、占用更多磁盘；在权限正常的环境可改回 hardlink 以节省磁盘。
package-import-method=copy

# peer 依赖自动安装；不使用严格 peer 失败，避免新主版本 peer 声明滞后阻塞安装
auto-install-peers=true
strict-peer-dependencies=false

# 工作区内一律优先使用 workspace 链接，避免误装 npm 上的同名包
link-workspace-packages=true
prefer-workspace-packages=true

# Node 版本不满足 engines 时只告警，不阻塞本地安装
engine-strict=false
