{
  "name": "researcher-manager",
  "version": "0.1.0",
  "private": true,
  "description": "大学生科研团队管理系统 monorepo（P3 基础工程骨架，可运行最小骨架）",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "verify": "pnpm verify:skeleton && pnpm verify:migrations && pnpm verify:openapi && pnpm verify:docker",
    "verify:skeleton": "node scripts/verify-skeleton.mjs",
    "verify:migrations": "node scripts/db-migrations-lint.mjs",
    "verify:openapi": "node scripts/openapi-contract-lint.mjs",
    "verify:docker": "node scripts/docker-packaging-check.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --fix",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "typecheck": "pnpm -r typecheck",
    "build:packages": "pnpm --filter @rm/shared build && pnpm --filter @rm/ai-adapter build",
    "build": "pnpm build:packages && pnpm --filter @rm/api build && pnpm --filter @rm/admin-web build",
    "test": "pnpm -r test",
    "dev:api": "pnpm build:packages && pnpm --filter @rm/api dev",
    "start:api": "pnpm --filter @rm/api start",
    "db:migrate": "pnpm build:packages && pnpm --filter @rm/api build && pnpm --filter @rm/api db:migrate",
    "db:migrate:status": "pnpm build:packages && pnpm --filter @rm/api build && pnpm --filter @rm/api db:migrate:status",
    "dev:admin": "pnpm --filter @rm/admin-web dev",
    "preview:admin": "pnpm --filter @rm/admin-web preview",
    "typecheck:miniapp": "pnpm --filter @rm/miniapp typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
