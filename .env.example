# ============================================================
# 环境变量示例文件（公开模板）
# 1. 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实密钥。
# 2. 本文件里的机密字段一律是**明显无效的占位符**，不是可用凭据；不得在这里填入
#    任何口令、token、私钥，也不得给出可复制后直接连上本机/生产库的默认连接串。
# 3. 真实密钥必须放入密钥管理系统，不得写入代码、文档或 CI 日志。
# 4. 变量名以 VITE_ 开头的会被前端构建打包进产物，绝对不要放密钥。
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- API 服务 ----------
API_PORT=3000
API_PREFIX=/api/v1
# 服务对外地址（用于日志、导出下载链接等）
API_PUBLIC_URL=http://127.0.0.1:3000

# ---------- PostgreSQL ----------
# 未配置时 API 仍可启动（/health 报告 database.configured=false）；NODE_ENV=production 时缺少
# DATABASE_URL 会直接拒绝启动（fail-closed）。
#
# 重要：只要解析出 DATABASE_URL，启动期持久化边界就会要求「经过 attest 且证据完整的 SQL
# 执行器」与「认证依赖（会话存储）先就绪」。会话存储切片尚未落地，因此当前**无法**带着
# DATABASE_URL 启动 API —— 这是设计上的 fail-closed，不是配置错误。
#
# 下面这行的主机名 `.invalid` 是保留 TLD（RFC 2606），**永不解析**：复制本模板也连不上
# 任何数据库。用户名/口令同理只是占位符（沿用 .env.docker.example 的 `change-me-*` 约定，
# 便于静态门禁识别「这里只允许占位符」）。请在真实 .env 里换成自己的值。
# 本地开发库见仓库根 docker-compose.yml，凭据只从 .env.docker 读取（无内置默认口令）：
#   cp .env.docker.example .env.docker && 按其中说明填写 POSTGRES_* 与 SESSION_SECRET
#   docker compose --env-file .env.docker up -d postgres     # 本地库发布在 127.0.0.1:55432
# 要用本机开发库时，自己在 .env 里把上面这行的用户名/口令改成 .env.docker 里的
# POSTGRES_USER / POSTGRES_PASSWORD，并把主机端口改成 127.0.0.1:55432。
DATABASE_URL=postgresql://change-me-db-user:change-me-db-password@db.example.invalid:5432/researcher_manager

# TLS：`DATABASE_SSL` 是旧开关（true=require / false=disable）；生产**只接受 verify-full**，
# 缺失或非安全 TLS 一律拒绝启动。本地 Compose 用显式 disable（仅开发环境允许，且需显式档位，
# 因为容器内主机名不是回环地址）。连接串里的 `sslmode` 同样生效。
DATABASE_SSL=false
# 也可直接用 DATABASE_SSL_MODE 表达档位（优先于 DATABASE_SSL）：
# DATABASE_SSL_MODE=disable
#
# verify-full 的证书只登记**路径**，内容必须来自挂载卷 / 密钥管理，绝不写入仓库
# （.gitignore 与 .dockerignore 都排除 certs/、*.pem、*.key）。路径必须是绝对路径，
# 且证书与私钥必须成对配置。
# DATABASE_SSL_CA_PATH=/etc/rm-tls/ca.pem
# DATABASE_SSL_CERT_PATH=/etc/rm-tls/client.crt
# DATABASE_SSL_KEY_PATH=/etc/rm-tls/client.key

# 连接池与超时（留空使用安全默认值：10 / 10000 / 30000）
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# 连接 application_name（1-63 位小写字母/数字/下划线/连字符）
DATABASE_APPLICATION_NAME=researcher-manager-api

# ---------- 执行器 attest 取证事实（缺任何一项 ⇒ 执行器拿不到封存声明 ⇒ 启动 fail-closed） ----------
# 这些值必须由**真的做过验证的人 / CI** 填写，代码不会生成「已验证」：
#   DATABASE_EXECUTOR_EVIDENCE_REF 必须是可核对的引用（CI 运行链接、集成测试用例路径等）
#   DATABASE_MIGRATION_APPLIED_VERSIONS 必须按 `pnpm db:migrate:status` 的真实输出核对后填写
# 下面给出的示例值只是**格式示意**（REPLACE-ME-*），照抄不会通过证据校验，也不能当成已验证事实。
# DATABASE_EXECUTOR_EVIDENCE_ID=REPLACE-ME-evidence-id
# DATABASE_EXECUTOR_VERIFIED_BY=REPLACE-ME-verified-by
# DATABASE_EXECUTOR_VERIFIED_AT=REPLACE-ME-verified-at
# DATABASE_EXECUTOR_EVIDENCE_REF=REPLACE-ME-evidence-ref
# DATABASE_EXECUTOR_EVIDENCE_METHOD=REPLACE-ME-evidence-method
# DATABASE_SCHEMA_READINESS_ID=REPLACE-ME-schema-readiness-id
# DATABASE_SCHEMA_CHECKED_BY=REPLACE-ME-checked-by
# DATABASE_SCHEMA_CHECKED_AT=REPLACE-ME-checked-at
# DATABASE_SCHEMA_READINESS_REF=REPLACE-ME-readiness-ref
# DATABASE_MIGRATION_AVAILABLE_VERSIONS=0001
# DATABASE_MIGRATION_APPLIED_VERSIONS=0001
#
# 迁移 CLI 可选覆盖（默认按 pnpm-workspace.yaml 向上定位仓库根后取 db/migrations）
# DATABASE_MIGRATIONS_DIR=
# DATABASE_MIGRATION_APPLIED_BY=dsh-db-migrate
#
# 集成测试开关：只有设置了它（或库名含 test 的 DATABASE_URL）才跑真实 PostgreSQL 用例
# （都不满足时**显式 skip**，不伪造通过；目标库名不含 test 时用例直接失败）
# TEST_DATABASE_URL=postgresql://change-me-db-user:change-me-db-password@127.0.0.1:55432/researcher_manager_test

# ---------- 会话与安全 ----------
# 至少 32 字节随机值：openssl rand -base64 48；必须替换本占位符后再启动，
# 照抄占位符等于把会话密钥公开在仓库里（开发环境也不例外）。
SESSION_SECRET=change-me-session-secret

# ---------- 微信小程序（首期暂缓发布，仅占位） ----------
WECHAT_MINIAPP_APP_ID=REPLACE-ME-wechat-miniapp-app-id
WECHAT_MINIAPP_APP_SECRET=REPLACE-ME-wechat-miniapp-app-secret

# ---------- AI 适配层 ----------
# AI_PROVIDER: mock = 本地不联网桩实现；http-json = 兼容 OpenAI Chat Completions 的服务
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=REPLACE-ME-ai-api-key
AI_MODEL=
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=1
# 匹配功能总开关；关闭时业务仍可浏览小组和提交申请（AI 降级路径）
AI_MATCHING_ENABLED=false

# ---------- 导出与文件 ----------
EXPORT_FILE_TTL_MINUTES=60
EXPORT_MAX_ROWS=50000

# ---------- Admin Web（Vite，构建期注入） ----------
# apps/admin-web 的 vite.config.ts 将 envDir 指向仓库根目录
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
